{
    "$schema": "https://v2-9-12.turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build",
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**"
            ],
            "passThroughEnv": [
                "SENTRY_AUTH_TOKEN"
            ]
        },
        "lint": {
            "dependsOn": [
                "^build"
            ]
        },
        "check-types": {
            "dependsOn": [
                "^check-types"
            ]
        },
        "dev": {
            "persistent": true,
            "cache": false
        }
    }
}
