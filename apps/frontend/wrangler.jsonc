{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "frontend",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/fetch-handler",
	"vars": {
		"NEXT_PUBLIC_FRONTEND_URL": "https://mindustry-tool.com",
		"NEXT_PUBLIC_BACKEND_V4_URL": "https://api.mindustry-tool.com/api/v4",
		"NEXT_PUBLIC_BACKEND_SOCKET_URL": "wss://api.mindustry-tool.com",
		"NEXT_PUBLIC_CLOUDINARY_IMAGE_URL": "https://api.mindustry-tool.com/static",
		"NEXT_PUBLIC_REQUEST_TIMEOUT": "15000"
	},
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"routes": [
		{
			"pattern": "mindustry-tool.com",
			"custom_domain": true
		},
		{
			"pattern": "www.mindustry-tool.com",
			"custom_domain": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "VINEXT_KV_CACHE",
			"id": "02afc8bac9594c7c8d92ded39cf6d1f1"
		}
	]
}
