{
    "name": "backend",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "main": "dist/main.js",
    "scripts": {
        "check-types": "tsc --noEmit",
        "build": "nest build",
        "start": "nest start",
        "dev": "nest start --watch",
        "generate": "prisma generate",
        "debug": "nest start --debug --watch",
        "prod": "node dist/src/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --no-cache --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@keyv/redis": "^5.1.6",
        "@mindustry-tool/api": "workspace:*",
        "@nestjs/cache-manager": "^3.0.1",
        "@nestjs/common": "^11.1.9",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.9",
        "@nestjs/jwt": "^11.0.1",
        "@nestjs/mapped-types": "^2.1.0",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.9",
        "@nestjs/schedule": "^6.0.1",
        "@nestjs/swagger": "^11.2.3",
        "@nestjs/websockets": "^11.1.9",
        "@prisma/adapter-pg": "^7.0.0",
        "@prisma/client": "^7.0.0",
        "@prisma/client-runtime-utils": "^7.8.0",
        "@types/ws": "^8.5.10",
        "adm-zip": "^0.5.16",
        "cache-manager": "^7.2.5",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "compression": "^1.8.1",
        "cookie": "^1.0.2",
        "cookie-parser": "^1.4.7",
        "cookie-signature": "^1.2.2",
        "eventsource-parser": "^3.0.6",
        "express": "^5.1.0",
        "file-type": "^22.0.1",
        "geoip-country": "^5.0.202610030217",
        "image-size": "^2.0.2",
        "ioredis": "^5.8.2",
        "leo-profanity": "^1.9.0",
        "minio": "^8.0.7",
        "nestjs-form-data": "^1.9.93",
        "nestjs-zod": "^5.0.1",
        "octokit": "^5.0.5",
        "p-queue": "^9.1.0",
        "passport": "^0.7.0",
        "passport-discord": "^0.1.4",
        "passport-google-oauth20": "^2.0.0",
        "prom-client": "^15.1.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sharp": "^0.33.5",
        "uuid": "^11.1.1",
        "ws": "^8.17.0",
        "zod": "^4.1.13"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@eslint/js": "^9.39.1",
        "@nestjs/cli": "^11.0.12",
        "@nestjs/schematics": "^11.0.9",
        "@nestjs/testing": "^11.1.9",
        "@swc/cli": "^0.6.0",
        "@swc/core": "^1.15.3",
        "@types/adm-zip": "^0.5.7",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.5",
        "@types/geoip-country": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.19.1",
        "@types/passport-discord": "^0.1.15",
        "@types/passport-google-oauth20": "^2.0.17",
        "@types/supertest": "^6.0.3",
        "eslint": "^9.39.1",
        "globals": "^16.5.0",
        "jest": "^29.7.0",
        "prisma": "^7.0.0",
        "safe-regex": "^2.1.1",
        "source-map-support": "^0.5.21",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.5",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.48.1"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": [
                "ts-jest",
                {
                    "tsconfig": "tsconfig.json"
                }
            ]
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/$1",
            "^file-type$": "<rootDir>/../test/__mocks__/file-type.js",
            "^p-queue$": "<rootDir>/../test/__mocks__/p-queue.js",
            "^octokit$": "<rootDir>/../test/__mocks__/octokit.js",
            "^(\\.{1,2}/.*)\\.js$": "$1"
        }
    }
}
