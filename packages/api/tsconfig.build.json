{
    "compilerOptions": {
        "target": "es6",
        "lib": [
            "ESNext",
            "DOM"
        ],
        "downlevelIteration": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "declaration": true,
        "strict": true,
        "pretty": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "experimentalDecorators": true,
        "outDir": "./build",
        "rootDir": "./src",
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
